# OpenRouter key for the LLM triage + editor's note (optional: without it the pipeline ranks heuristically)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# One Discord webhook per edition (names are set in config/editions/*.json → discordWebhookEnv)
DISCORD_GENERAL_WEBHOOK_URL=
DISCORD_MEDICAL_WEBHOOK_URL=
DISCORD_EDUCATION_WEBHOOK_URL=
